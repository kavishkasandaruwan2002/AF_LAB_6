<!DOCTYPE html>
<html>
<head>
  <title>Social Media Posts</title>
  <style>
    body { font-family: sans-serif; max-width: 700px; margin: 40px auto; }
    .post { border: 1px solid #ddd; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
    .post img { max-width: 100%; border-radius: 4px; }
    .meta { font-size: 12px; color: #888; }
  </style>
</head>
<body>
  <h1>All Posts</h1>
  <% posts.forEach(post => { %>
    <div class="post">
      <h2><%= post.title %></h2>
      <p><%= post.content %></p>
      <% if (post.imageUrl) { %><img src="<%= post.imageUrl %>"><% } %>
      <p class="meta">By <%= post.author %> on <%= post.createdAt %></p>
    </div>
  <% }) %>
</body>
</html>
